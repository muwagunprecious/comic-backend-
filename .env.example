# Server Configuration
PORT=5000
NODE_ENV=production

# Database (PostgreSQL / Supabase / Neon connection string)
# Leave empty to use local store for testing, or supply Supabase/Neon PostgreSQL URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# CORS & Frontend URLs
FRONTEND_URL=https://slumart.org
CORS_ORIGIN=*

# Admin Secret Key & JWT
ADMIN_SECRET=your_admin_secret_here
JWT_SECRET=your_jwt_secret_here

# Paystack Payment Gateway (Get from https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Flutterwave Payment Gateway (Get from https://dashboard.flutterwave.com/settings/apis)
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key_here
